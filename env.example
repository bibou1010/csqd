# Copie ce fichier en ".env" et renseigne au moins une clé
# Pexels (gratuit) : https://www.pexels.com/api/
PEXELS_API_KEY=colle_ta_cle_ici

# Pixabay (optionnel, gratuit) : source supplémentaire d'images/vidéos
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Nombre d'options proposées par scène dans l'interface web
CANDIDATES_PER_SCENE=4

# Mot de passe pour protéger l'app si elle est hébergée en ligne (laisser vide en local)
APP_PASSWORD=

# Optionnel : voix off automatique (Google Text-to-Speech, gratuit, pas de clé requise)
ENABLE_TTS=false
TTS_LANG=fr

# Dossier contenant tes musiques libres de droit (mp3/wav)
# Sources gratuites : Pixabay Music, YouTube Audio Library, Free Music Archive
MUSIC_DIR=assets/music
MUSIC_VOLUME=0.15

# Durée par défaut (en secondes) d'un segment si pas de voix off
DEFAULT_SEGMENT_DURATION=4.5
